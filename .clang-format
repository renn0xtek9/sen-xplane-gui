BasedOnStyle: LLVM
IndentWidth: 2
ColumnLimit: 120
PointerAlignment: Left
DerivePointerAlignment: false
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '<(Q|Qt).*>'
    Priority:        1
    SortPriority:    1
  - Regex:           '<[[:alnum:].]+>'
    Priority:        2
    SortPriority:    2
  - Regex:           '<sen/.*'
    Priority:        3
    SortPriority:    3
    CaseSensitive:   true
  - Regex:           '<stl/.*'
    Priority:        4
    SortPriority:    4
    CaseSensitive:   true
  - Regex:           '<hmi/.*'
    Priority:        5
    SortPriority:    5
  - Regex:           '.*'
    Priority:        6
    SortPriority:    6
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
NamespaceIndentation: None
